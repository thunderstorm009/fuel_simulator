# Copy to .env and fill in. Never commit .env.
SIM_BASE_URL=http://simulator:8000
SIMULATOR_START_MODE=paused
SIMULATION_SPEED=8
TICK_MINUTES=15
INGEST_INTERVAL_S=5
SIM_MAX_RETRIES=3
SIM_CONNECT_TIMEOUT_S=2
SIM_READ_TIMEOUT_S=3
SIM_STREAM_READ_TIMEOUT_S=20
SIM_BREAKER_FAILURE_THRESHOLD=5
SIM_BREAKER_RESET_S=10
PREDICTOR_TIMEOUT_S=1.5
PREDICTOR_BREAKER_FAILURE_THRESHOLD=5
PREDICTOR_BREAKER_RESET_S=10
DATABASE_URL=postgresql://fuel:fuel-local@postgres:5432/fuel
OPERATOR_TOKEN=change-me
CORS_ORIGIN=http://localhost:5173
FRONTEND_HOST_PORT=5173
POSTGRES_DB=fuel
POSTGRES_USER=fuel
POSTGRES_PASSWORD=fuel-local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-demo-only
VITE_API_URL=http://localhost:8101
PREDICTOR_URL=http://predictor:8103
# Optional stretch only:
ANTHROPIC_API_KEY=
